<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="LanShare.Desktop" version="1.0.0.0" processorArchitecture="amd64"/>
  <description>LanShare Desktop Client</description>

  <!-- DPI 感知：PerMonitorV2
       缺这一段时进程是 DPI-unaware，Windows 会把整个窗口按 150% 位图拉伸
       （界面发虚、字大、点击位置偏移），并且 WebView2 的坐标换算和宿主对不上
       → 表现为"分辨率不对 + 窗口上下有缝 + 右侧内容被裁切"（用户实测）。
       注意：manifest 里声明后，SetProcessDpiAwarenessContext 的调用会失效
       （系统以 manifest 为准），两者不冲突。 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <!-- Win10/11 兼容性声明：让系统按现代行为运行（通知、主题、DPI 等） -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Win10/11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- Win8.1 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/> <!-- Vista -->
    </application>
  </compatibility>
</assembly>
